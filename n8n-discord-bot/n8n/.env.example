# n8n encryption key (REQUIRED) - generate a 64-char random string
# openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Basic auth (optional, recommended for production)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

# Webhook URL (override if using custom domain)
WEBHOOK_URL=https://alitravians-n8n.fly.dev
N8N_HOST=alitravians-n8n.fly.dev
N8N_EDITOR_BASE_URL=https://alitravians-n8n.fly.dev

# Timezone
GENERIC_TIMEZONE=Asia/Riyadh
TZ=Asia/Riyadh
