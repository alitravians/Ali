        "responseMode": "lastNode",
        "options": {}
      },
      "id": "trig-msg",
      "name": "Webhook: message-create",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        220
      ],
      "webhookId": "discord-message-xp"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "discord/slash-command/level",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "trig-cmd",
      "name": "Webhook: /level",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        480
      ],
      "webhookId": "discord-slash-level"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "discord/slash-command/leaderboard",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "trig-cmd-lb",
      "name": "Webhook: /leaderboard",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        620
      ],
      "webhookId": "discord-slash-leaderboard"
    },
    {
      "parameters": {
        "jsCode": "// dailyCounters live in workflow 09's static data, NOT here.\n// $getWorkflowStaticData('global') is scoped per-workflow, so the stats\n// dashboard cannot read counters written from this workflow. The gateway\n// bridge forwards every MESSAGE_CREATE to '/discord/message-create/stats'\n// in workflow 09 where the messages counter is actually maintained.\nconst staticData = $getWorkflowStaticData('global');\nstaticData.xp = staticData.xp || {};\nstaticData.lastMsg = staticData.lastMsg || {};\n\nconst body = $input.first().json.body;\nconst userId = body.author.id;\nconst now = Date.now();\nconst COOLDOWN_MS = 60000;\nconst lastMs = staticData.lastMsg[userId] || 0;\n\nif (now - lastMs < COOLDOWN_MS) {\n  return [{ json: { skip: true } }];\n}\nstaticData.lastMsg[userId] = now;\n\nconst current = staticData.xp[userId] || { xp: 0, level: 0, username: body.author.username };\nconst gain = 15 + Math.floor(Math.random() * 11);\ncurrent.xp += gain;\ncurrent.username = body.author.username;\n\nconst xpForNext = (lvl) => 5 * lvl * lvl + 50 * lvl + 100;\nlet leveledUp = false;\nlet newLevel = current.level;\nwhile (current.xp >= xpForNext(newLevel)) {\n  current.xp -= xpForNext(newLevel);\n  newLevel += 1;\n  leveledUp = true;\n}\ncurrent.level = newLevel;\nstaticData.xp[userId] = current;\n\nreturn [{ json: { skip: false, leveledUp, newLevel, userId, username: body.author.username, channelId: body.channelId, totalXp: current.xp, guildId: body.guildId } }];"
      },
      "id": "calc-xp",
      "name": "Calc XP + level",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        220
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-lvl",
              "leftValue": "={{ $json.leveledUp }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-leveled",
      "name": "IF: leveled up",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://discord.com/api/v10/channels/{{ $json.channelId }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  \"content\": `🎉 مبروك <@${$json.userId}>! وصلت للمستوى **${$json.newLevel}**`,\n  \"allowed_mentions\": { \"users\": [$json.userId] }\n}) }}",
        "options": {
          "ignoreResponseCode": true
        }
      },
      "id": "announce-lvl",
      "name": "Discord: announce level-up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        140
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "discord-bot-auth",
          "name": "Discord Bot Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nstaticData.xp = staticData.xp || {};\nconst body = $input.first().json.body;\nconst cmd = body.commandName;\n\n// Cumulative XP earned from level 0 to the start of `level`, plus remaining xp.\n// Matches xpForNext(lvl) = 5*lvl^2 + 50*lvl + 100 used during XP gain.\nconst cumulativeXp = (level, xp) => {\n  let total = 0;\n  for (let i = 0; i < level; i++) total += 5 * i * i + 50 * i + 100;\n  return total + xp;\n};\n\nif (cmd === 'level') {\n  const targetUserId = body.options.user || body.user.id;\n  const record = staticData.xp[targetUserId] || { xp: 0, level: 0, username: 'مجهول' };\n  const xpForNext = 5 * record.level * record.level + 50 * record.level + 100;\n  return [{ json: { mode: 'level', userId: targetUserId, record, xpForNext, interactionToken: body.interactionToken, applicationId: body.applicationId } }];\n} else if (cmd === 'leaderboard') {\n  const sorted = Object.entries(staticData.xp).map(([uid, d]) => ({ userId: uid, ...d, totalXp: cumulativeXp(d.level, d.xp) })).sort((a, b) => b.totalXp - a.totalXp).slice(0, 10);\n  return [{ json: { mode: 'leaderboard', sorted, interactionToken: body.interactionToken, applicationId: body.applicationId } }];\n}\nreturn [{ json: { skip: true } }];"
      },
      "id": "handle-cmd",
      "name": "Handle /level + /leaderboard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        480
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-mode",
              "leftValue": "={{ $json.mode }}",
              "rightValue": "level",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-mode-lvl",
      "name": "IF: mode=level",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        480
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://discord.com/api/v10/webhooks/{{ $json.applicationId }}/{{ $json.interactionToken }}/messages/@original",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  \"embeds\": [{\n    \"title\": `📊 مستوى ${$json.record.username}`,\n    \"description\": `**المستوى:** ${$json.record.level}\\n**XP:** ${$json.record.xp} / ${$json.xpForNext}\\n**التقدم:** ${'█'.repeat(Math.floor(($json.record.xp / $json.xpForNext) * 10))}${'░'.repeat(10 - Math.floor(($json.record.xp / $json.xpForNext) * 10))}`,\n    \"color\": 3447003\n  }]\n}) }}",
        "options": {
          "ignoreResponseCode": true
        }
      },
      "id": "send-level",
      "name": "Discord: send level card",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
