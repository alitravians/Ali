    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://discord.com/api/v10/webhooks/{{ $json.applicationId }}/{{ $json.interactionToken }}/messages/@original",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  \"embeds\": [{\n    \"title\": \"🏆 قائمة المتصدرين\",\n    \"description\": $json.sorted.length ? $json.sorted.map((s, i) => `**${i+1}.** ${s.username} - المستوى ${s.level} (${s.totalXp} XP)`).join('\\n') : 'لا توجد بيانات بعد',\n    \"color\": 16766720\n  }]\n}) }}",
        "options": {
          "ignoreResponseCode": true
        }
      },
      "id": "send-lb",
      "name": "Discord: send leaderboard",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
