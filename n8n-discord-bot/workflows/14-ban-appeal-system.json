    {
      "parameters": {
        "jsCode": "// Staff posted in an appeal thread. Look up the appeal by threadId. Skip\n// system messages, command-attempts (starts with '/'), and any message we\n// cannot resolve to an appeal.\nconst data = $getWorkflowStaticData('global');\nconst body = $input.first().json.body || $input.first().json;\nconst threadId = body.threadId;\nconst content = (body.content || '').toString();\n\nif (!threadId) {\n  return [{ json: { shouldRelay: false, reason: 'no-thread-id' } }];\n}\nif (!content || content.trim().startsWith('/')) {\n  return [{ json: { shouldRelay: false, reason: 'empty-or-command' } }];\n}\n\nconst appealId = data.threadToAppeal?.[threadId];\nconst appeal = appealId ? data.appeals?.[appealId] : null;\n\nif (!appeal || !appeal.dmChannelId) {\n  return [{ json: { shouldRelay: false, reason: 'no-appeal' } }];\n}\nif (['resolved-rejected', 'resolved-unban', 'resolved-reduced', 'superseded'].includes(appeal.status)) {\n  return [{ json: { shouldRelay: false, reason: 'appeal-closed' } }];\n}\n\nappeal.status = 'awaiting-user';\nappeal.lastActivityAt = Date.now();\n\nconst cleaned = content.slice(0, 1500);\nconst author = body.author || {};\n\nreturn [{ json: {\n  shouldRelay: true,\n  appealId: appeal.appealId,\n  userId: appeal.userId,\n  dmChannelId: appeal.dmChannelId,\n  staffName: author.displayName || author.username || 'الإدارة',\n  cleaned,\n} }];\n"
      },
