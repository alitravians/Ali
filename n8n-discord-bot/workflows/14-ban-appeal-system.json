      "parameters": {
        "jsCode": "// Extract thread ID from POST /channels/{id}/threads response, index it,\n// persist to static data so subsequent dm-message and thread-message webhooks\n// can find the appeal by either userId or threadId.\nconst data = $getWorkflowStaticData('global');\nconst appealId = $('appeal-register').first().json.appealId;\nconst appeal = data.appeals?.[appealId];\nconst thread = $input.first().json;\nconst threadId = thread?.id || null;\nif (appeal && threadId) {\n  appeal.threadId = threadId;\n  data.threadToAppeal = data.threadToAppeal || {};\n  data.threadToAppeal[threadId] = appealId;\n}\nreturn [{ json: { ...$('appeal-save-dm').first().json, threadId, appeal } }];\n"
      },
