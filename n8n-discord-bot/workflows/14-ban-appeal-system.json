        240,
        620
      ],
      "webhookId": "discord-appeal-thread-message"
    },
    {
      "parameters": {
        "jsCode": "// Staff posted in an appeal thread. Look up the appeal by threadId. Skip\n// system messages, command-attempts (starts with '/'), and any message we\n// cannot resolve to an appeal.\nconst data = $getWorkflowStaticData('global');\nconst body = $input.first().json.body || $input.first().json;\nconst threadId = body.threadId;\nconst content = (body.content || '').toString();\n\nif (!threadId) {\n  return [{ json: { shouldRelay: false, reason: 'no-thread-id' } }];\n}\nif (!content || content.trim().startsWith('/')) {\n  return [{ json: { shouldRelay: false, reason: 'empty-or-command' } }];\n}\n\nconst appealId = data.threadToAppeal?.[threadId];\nconst appeal = appealId ? data.appeals?.[appealId] : null;\n\nif (!appeal || !appeal.dmChannelId) {\n  return [{ json: { shouldRelay: false, reason: 'no-appeal' } }];\n}\nif (appeal.status === 'resolved-rejected' || appeal.status === 'resolved-unban') {\n  return [{ json: { shouldRelay: false, reason: 'appeal-closed' } }];\n}\n\nappeal.status = 'awaiting-user';\nappeal.lastActivityAt = Date.now();\n\nconst cleaned = content.slice(0, 1500);\nconst author = body.author || {};\n\nreturn [{ json: {\n  shouldRelay: true,\n  appealId: appeal.appealId,\n  userId: appeal.userId,\n  dmChannelId: appeal.dmChannelId,\n  staffName: author.displayName || author.username || '\u0627\u0644\u0625\u062f\u0627\u0631\u0629',\n  cleaned,\n} }];\n"
      },
      "id": "thread-route",
      "name": "thread-route",
      "type": "n8n-nodes-base.code",
