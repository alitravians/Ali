        240,
        880
      ],
      "webhookId": "discord-slash-command-resolve"
    },
    {
      "parameters": {
        "jsCode": "// Staff invoked /resolve in an appeal thread. Validate the action, compute\n// the dm text, and emit the action so the Switch node can branch.\nconst data = $getWorkflowStaticData('global');\nconst body = $input.first().json.body || $input.first().json;\nconst options = body.options || {};\nconst action = options.action;\nconst reason = (options.reason || '').toString().slice(0, 1500) || '\u0644\u0645 \u064a\u064f\u0630\u0643\u0631 \u0633\u0628\u0628.';\nconst minutes = Number(options.minutes || 0);\nconst channelId = body.channelId; // the thread the command was invoked in\n\nif (!channelId) {\n  return [{ json: { ok: false, error: 'missing-channel', interactionToken: body.interactionToken, applicationId: body.applicationId } }];\n}\n\nconst appealId = data.threadToAppeal?.[channelId];\nconst appeal = appealId ? data.appeals?.[appealId] : null;\nif (!appeal) {\n  return [{ json: { ok: false, error: 'no-appeal-for-thread', interactionToken: body.interactionToken, applicationId: body.applicationId } }];\n}\nif (!['unban','reject','reduce'].includes(action)) {\n  return [{ json: { ok: false, error: 'invalid-action', interactionToken: body.interactionToken, applicationId: body.applicationId } }];\n}\nif (action === 'reduce' && (!minutes || minutes < 10)) {\n  return [{ json: { ok: false, error: 'reduce-needs-minutes', interactionToken: body.interactionToken, applicationId: body.applicationId } }];\n}\n\nconst now = Date.now();\nlet userMessage = '';\nlet newExpireAt = appeal.expireAt;\nif (action === 'unban') {\n  appeal.status = 'resolved-unban';\n  appeal.closedAt = now;\n  userMessage = `\u2705 \u062a\u0645 \u0642\u0628\u0648\u0644 \u0627\u0639\u062a\u0631\u0627\u0636\u0643 \u0648\u0631\u0641\u0639 \u0627\u0644\u062d\u0638\u0631.\\n\\n**\u0633\u0628\u0628 \u0627\u0644\u0625\u062f\u0627\u0631\u0629:**\\n> ${reason}\\n\\n\u062a\u0642\u062f\u0631 \u062a\u0639\u0648\u062f \u0644\u0644\u0633\u064a\u0631\u0641\u0631 \u0627\u0644\u0622\u0646.`;\n} else if (action === 'reject') {\n  appeal.status = 'resolved-rejected';\n  appeal.closedAt = now;\n  userMessage = `\u274c \u062a\u0645 \u0631\u0641\u0636 \u0627\u0639\u062a\u0631\u0627\u0636\u0643.\\n\\n**\u0633\u0628\u0628 \u0627\u0644\u0625\u062f\u0627\u0631\u0629:**\\n> ${reason}\\n\\n\u0627\u0644\u062d\u0638\u0631 \u0628\u0627\u0642\u064a \u062d\u062a\u0649: ${appeal.expireAt}\\n\u0644\u0627 \u064a\u0645\u0643\u0646 \u0641\u062a\u062d \u0627\u0639\u062a\u0631\u0627\u0636 \u062c\u062f\u064a\u062f \u0644\u0646\u0641\u0633 \u0627\u0644\u062d\u0638\u0631.`;\n} else {\n  // reduce\n  newExpireAt = new Date(now + minutes * 60 * 1000).toISOString();\n  appeal.expireAt = newExpireAt;\n  appeal.durationMin = minutes;\n  appeal.status = 'resolved-reduced';\n  appeal.lastActivityAt = now;\n  userMessage = `\u26a0\ufe0f \u062a\u0645 \u062a\u062e\u0641\u064a\u0641 \u0645\u062f\u0629 \u062d\u0638\u0631\u0643.\\n\\n**\u0627\u0644\u0645\u062f\u0629 \u0627\u0644\u062c\u062f\u064a\u062f\u0629:** ${minutes} \u062f\u0642\u064a\u0642\u0629 (\u062a\u0646\u062a\u0647\u064a: ${newExpireAt})\\n**\u0633\u0628\u0628 \u0627\u0644\u0625\u062f\u0627\u0631\u0629:**\\n> ${reason}`;\n}\n\nreturn [{ json: {\n  ok: true,\n  action,\n  appealId: appeal.appealId,\n  userId: appeal.userId,\n  guildId: appeal.guildId,\n  threadId: appeal.threadId,\n  dmChannelId: appeal.dmChannelId,\n  userMessage,\n  reason,\n  minutes,\n  newExpireAt,\n  interactionToken: body.interactionToken,\n  applicationId: body.applicationId,\n} }];\n"
      },
