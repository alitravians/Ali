    {
      "parameters": {
        "jsCode": "// User replied to the bot in DM. Look up their open appeal. If none,\n// reply with a polite \"no open appeal\" DM (still uses the DM channel from\n// the incoming message). If found, prepare to relay to the staff thread.\nconst data = $getWorkflowStaticData('global');\nconst body = $input.first().json.body || $input.first().json;\nconst userId = body.author?.id;\nconst content = (body.content || '').toString();\nconst dmChannelId = body.channelId;\n\nif (!userId) {\n  return [{ json: { hasAppeal: false, reason: 'no-user-id' } }];\n}\n\nconst appealId = data.userToAppeal?.[userId];\nconst appeal = appealId ? data.appeals?.[appealId] : null;\n\nif (!appeal || !appeal.threadId) {\n  // No open appeal - reply to user explaining (only once per cooldown).\n  appeal && (appeal.lastUnsolicitedAt = Date.now());\n  return [{ json: {\n    hasAppeal: false,\n    dmChannelId,\n    userId,\n    replyMessage: 'لا يوجد طلب اعتراض مفتوح باسمك حالياً. لو تم حظرك مؤخراً، تحقق من رسالة الحظر للحصول على رابط نظام الاعتراض. لو ما عندك طلب فعّال، الإدارة ما راح تشوف هذي الرسالة.',\n  } }];\n}\n\nif (appeal.status === 'resolved-rejected' || appeal.status === 'resolved-unban') {\n  return [{ json: {\n    hasAppeal: false,\n    dmChannelId,\n    userId,\n    replyMessage: 'طلب اعتراضك تم حسمه مسبقاً. لو عندك استفسار جديد، تواصل مع الإدارة في القنوات الرسمية.',\n  } }];\n}\n\n// Cap message size at 1500 chars to avoid Discord limits / spam.\nconst cleaned = content.slice(0, 1500);\nappeal.status = 'awaiting-staff';\nappeal.lastActivityAt = Date.now();\nappeal.messageCount = (appeal.messageCount || 0) + 1;\n\nreturn [{ json: {\n  hasAppeal: true,\n  appealId: appeal.appealId,\n  threadId: appeal.threadId,\n  userId,\n  username: body.author?.username || appeal.username,\n  dmChannelId,\n  cleaned,\n} }];\n"
      },
