    {
      "parameters": {
        "httpMethod": "POST",
        "path": "discord/slash-command/resolve",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-resolve",
      "name": "Webhook: /resolve",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        880
      ],
      "webhookId": "discord-slash-command-resolve"
    },
    {
      "parameters": {
        "jsCode": "// Staff invoked /resolve in an appeal thread. Validate the action, compute\n// the dm text, and emit the action so the Switch node can branch.\nconst data = $getWorkflowStaticData('global');\nconst body = $input.first().json.body || $input.first().json;\nconst options = body.options || {};\nconst action = options.action;\nconst reason = (options.reason || '').toString().slice(0, 1500) || 'لم يُذكر سبب.';\nconst minutes = Number(options.minutes || 0);\nconst channelId = body.channelId; // the thread the command was invoked in\n\nif (!channelId) {\n  return [{ json: { ok: false, error: 'missing-channel', interactionToken: body.interactionToken, applicationId: body.applicationId } }];\n}\n\nconst appealId = data.threadToAppeal?.[channelId];\nconst appeal = appealId ? data.appeals?.[appealId] : null;\nif (!appeal) {\n  return [{ json: { ok: false, error: 'no-appeal-for-thread', interactionToken: body.interactionToken, applicationId: body.applicationId } }];\n}\n// Reject /resolve on appeals that are already closed (resolved or superseded).\n// Without this guard, staff invoking /resolve unban in an old superseded\n// thread would lift the user's current, more severe ban.\nconst closedStatuses = ['superseded', 'resolved-unban', 'resolved-rejected', 'resolved-reduced'];\nif (closedStatuses.includes(appeal.status)) {\n  return [{ json: { ok: false, error: 'appeal-already-closed (' + appeal.status + ')', interactionToken: body.interactionToken, applicationId: body.applicationId } }];\n}\nif (!['unban','reject','reduce'].includes(action)) {\n  return [{ json: { ok: false, error: 'invalid-action', interactionToken: body.interactionToken, applicationId: body.applicationId } }];\n}\nif (action === 'reduce' && (!minutes || minutes < 10)) {\n  return [{ json: { ok: false, error: 'reduce-needs-minutes', interactionToken: body.interactionToken, applicationId: body.applicationId } }];\n}\n\nconst now = Date.now();\nlet userMessage = '';\nlet newExpireAt = appeal.expireAt;\nif (action === 'unban') {\n  appeal.status = 'resolved-unban';\n  appeal.closedAt = now;\n  userMessage = `✅ تم قبول اعتراضك ورفع الحظر.\\n\\n**سبب الإدارة:**\\n> ${reason}\\n\\nتقدر تعود للسيرفر الآن.`;\n} else if (action === 'reject') {\n  appeal.status = 'resolved-rejected';\n  appeal.closedAt = now;\n  userMessage = `❌ تم رفض اعتراضك.\\n\\n**سبب الإدارة:**\\n> ${reason}\\n\\nالحظر باقي حتى: ${appeal.expireAt}\\nلا يمكن فتح اعتراض جديد لنفس الحظر.`;\n} else {\n  // reduce\n  newExpireAt = new Date(now + minutes * 60 * 1000).toISOString();\n  appeal.expireAt = newExpireAt;\n  appeal.durationMin = minutes;\n  appeal.status = 'resolved-reduced';\n  appeal.lastActivityAt = now;\n  userMessage = `⚠️ تم تخفيف مدة حظرك.\\n\\n**المدة الجديدة:** ${minutes} دقيقة (تنتهي: ${newExpireAt})\\n**سبب الإدارة:**\\n> ${reason}`;\n}\n\nreturn [{ json: {\n  ok: true,\n  action,\n  appealId: appeal.appealId,\n  userId: appeal.userId,\n  guildId: appeal.guildId,\n  threadId: appeal.threadId,\n  dmChannelId: appeal.dmChannelId,\n  userMessage,\n  reason,\n  minutes,\n  newExpireAt,\n  interactionToken: body.interactionToken,\n  applicationId: body.applicationId,\n} }];\n"
      },
      "id": "resolve-route",
      "name": "resolve-route",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
