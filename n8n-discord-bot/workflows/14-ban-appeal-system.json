    {
      "parameters": {
        "jsCode": "// User replied to the bot in DM. Look up their open appeal. If none,\n// reply with a polite \"no open appeal\" DM (still uses the DM channel from\n// the incoming message). If found, prepare to relay to the staff thread.\nconst data = $getWorkflowStaticData('global');\nconst body = $input.first().json.body || $input.first().json;\nconst userId = body.author?.id;\nconst content = (body.content || '').toString();\nconst dmChannelId = body.channelId;\n\nif (!userId) {\n  return [{ json: { hasAppeal: false, reason: 'no-user-id' } }];\n}\n\nconst appealId = data.userToAppeal?.[userId];\nconst appeal = appealId ? data.appeals?.[appealId] : null;\n\nif (!appeal || !appeal.threadId) {\n  // No open appeal - reply to user explaining (only once per cooldown).\n  appeal && (appeal.lastUnsolicitedAt = Date.now());\n  return [{ json: {\n    hasAppeal: false,\n    dmChannelId,\n    userId,\n    replyMessage: '\u0644\u0627 \u064a\u0648\u062c\u062f \u0637\u0644\u0628 \u0627\u0639\u062a\u0631\u0627\u0636 \u0645\u0641\u062a\u0648\u062d \u0628\u0627\u0633\u0645\u0643 \u062d\u0627\u0644\u064a\u0627\u064b. \u0644\u0648 \u062a\u0645 \u062d\u0638\u0631\u0643 \u0645\u0624\u062e\u0631\u0627\u064b\u060c \u062a\u062d\u0642\u0642 \u0645\u0646 \u0631\u0633\u0627\u0644\u0629 \u0627\u0644\u062d\u0638\u0631 \u0644\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0631\u0627\u0628\u0637 \u0646\u0638\u0627\u0645 \u0627\u0644\u0627\u0639\u062a\u0631\u0627\u0636. \u0644\u0648 \u0645\u0627 \u0639\u0646\u062f\u0643 \u0637\u0644\u0628 \u0641\u0639\u0651\u0627\u0644\u060c \u0627\u0644\u0625\u062f\u0627\u0631\u0629 \u0645\u0627 \u0631\u0627\u062d \u062a\u0634\u0648\u0641 \u0647\u0630\u064a \u0627\u0644\u0631\u0633\u0627\u0644\u0629.',\n  } }];\n}\n\nif (appeal.status === 'resolved-rejected' || appeal.status === 'resolved-unban') {\n  return [{ json: {\n    hasAppeal: false,\n    dmChannelId,\n    userId,\n    replyMessage: '\u0637\u0644\u0628 \u0627\u0639\u062a\u0631\u0627\u0636\u0643 \u062a\u0645 \u062d\u0633\u0645\u0647 \u0645\u0633\u0628\u0642\u0627\u064b. \u0644\u0648 \u0639\u0646\u062f\u0643 \u0627\u0633\u062a\u0641\u0633\u0627\u0631 \u062c\u062f\u064a\u062f\u060c \u062a\u0648\u0627\u0635\u0644 \u0645\u0639 \u0627\u0644\u0625\u062f\u0627\u0631\u0629 \u0641\u064a \u0627\u0644\u0642\u0646\u0648\u0627\u062a \u0627\u0644\u0631\u0633\u0645\u064a\u0629.',\n  } }];\n}\n\n// Cap message size at 1500 chars to avoid Discord limits / spam.\nconst cleaned = content.slice(0, 1500);\nappeal.status = 'awaiting-staff';\nappeal.lastActivityAt = Date.now();\nappeal.messageCount = (appeal.messageCount || 0) + 1;\n\nreturn [{ json: {\n  hasAppeal: true,\n  appealId: appeal.appealId,\n  threadId: appeal.threadId,\n  userId,\n  username: body.author?.username || appeal.username,\n  dmChannelId,\n  cleaned,\n} }];\n"
      },
