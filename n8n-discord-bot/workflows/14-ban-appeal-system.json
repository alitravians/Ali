    {
      "parameters": {
        "method": "POST",
        "url": "=https://discord.com/api/v10/channels/{{ $json.dmChannelId }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "ignoreResponseCode": true
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  \"content\": `\ud83d\udeab \u062a\u0645 \u062d\u0638\u0631\u0643 \u0645\u0646 \u0627\u0644\u0633\u064a\u0631\u0641\u0631.\\n\\n**\u0627\u0644\u0625\u062c\u0631\u0627\u0621:** ${$('appeal-register').first().json.appeal.severityLabel}\\n**\u0627\u0644\u0645\u062f\u0629:** ${$('appeal-register').first().json.appeal.durationMin} \u062f\u0642\u064a\u0642\u0629\\n**\u064a\u0646\u062a\u0647\u064a \u0641\u064a:** ${$('appeal-register').first().json.appeal.expireAt}\\n**\u0633\u0628\u0628 \u0627\u0644\u062d\u0638\u0631 (\u0643\u0644\u0645\u0627\u062a \u0645\u0645\u0646\u0648\u0639\u0629):** ${($('appeal-register').first().json.appeal.words || []).join(', ')}\\n\\n\ud83d\udce9 **\u0644\u0648 \u062a\u0628\u063a\u0649 \u062a\u0639\u062a\u0631\u0636 \u0639\u0644\u0649 \u0627\u0644\u062d\u0638\u0631:**\\n\u0631\u062f \u0639\u0644\u0649 \u0647\u0630\u064a \u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u0645\u0628\u0627\u0634\u0631\u0629 \u0628\u0631\u0633\u0627\u0644\u0629 \u0648\u0627\u062d\u062f\u0629 \u062a\u0634\u0631\u062d \u0641\u064a\u0647\u0627 \u0633\u0628\u0628 \u0627\u0639\u062a\u0631\u0627\u0636\u0643. \u0631\u0627\u062d \u064a\u0648\u0635\u0644 \u0631\u062f\u0643 \u0645\u0628\u0627\u0634\u0631\u0629 \u0644\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0633\u064a\u0631\u0641\u0631\u060c \u0648\u0631\u0627\u062d \u064a\u0631\u062f\u0648\u0646 \u0639\u0644\u064a\u0643 \u0645\u0646 \u0646\u0641\u0633 \u0647\u0630\u064a \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629.\\n\\n\u0645\u0644\u0627\u062d\u0638\u0629: \u0644\u0627 \u062a\u0631\u0633\u0644 \u0639\u062f\u0629 \u0631\u0633\u0627\u0626\u0644 \u0633\u0631\u064a\u0639\u0629. \u0631\u0633\u0627\u0644\u0629 \u0648\u0627\u062d\u062f\u0629 \u0643\u0627\u0641\u064a\u0629\u060c \u0648\u0627\u0644\u0625\u062f\u0627\u0631\u0629 \u0628\u062a\u0631\u062f \u0642\u0631\u064a\u0628\u0627\u064b.`\n}) }}"
      },
