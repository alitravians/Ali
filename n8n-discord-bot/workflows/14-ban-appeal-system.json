      "id": "wh-appeal-create",
      "name": "Webhook: appeal-create",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        100
      ],
      "webhookId": "discord-appeal-create"
    },
    {
      "parameters": {
        "jsCode": "// Register a new ban appeal from workflow 03's BAN branch.\n// Input: { userId, username, guildId, severity, severityLabel, durationMin,\n//          expireAt, words: [...], originalContent, originalChannelId, messageId }\nconst data = $getWorkflowStaticData('global');\ndata.appeals = data.appeals || {};\ndata.userToAppeal = data.userToAppeal || {};\ndata.threadToAppeal = data.threadToAppeal || {};\ndata.nextAppealId = data.nextAppealId || 1;\n\nconst body = $input.first().json.body || $input.first().json;\n\n// If a user already has an open appeal, close the old one so the new ban's\n// thread is the authoritative one. Old thread is left in place for audit.\nconst prevAppealId = data.userToAppeal[body.userId];\nif (prevAppealId && data.appeals[prevAppealId]) {\n  const prev = data.appeals[prevAppealId];\n  if (prev.status && prev.status.startsWith('awaiting-')) {\n    prev.status = 'superseded';\n    prev.closedAt = Date.now();\n  }\n}\n\nconst appealId = String(data.nextAppealId++);\nconst now = Date.now();\nconst appeal = {\n  appealId,\n  userId: body.userId,\n  username: body.username || 'unknown',\n  guildId: body.guildId,\n  severity: body.severity || null,\n  severityLabel: body.severityLabel || '',\n  durationMin: Number(body.durationMin || 0),\n  banAt: now,\n  expireAt: body.expireAt || null,\n  words: Array.isArray(body.words) ? body.words : [],\n  originalContent: (body.originalContent || '').toString().slice(0, 1500),\n  originalChannelId: body.originalChannelId || null,\n  messageId: body.messageId || null,\n  status: 'awaiting-user',\n  createdAt: now,\n  lastActivityAt: now,\n  messageCount: 0,\n  dmChannelId: null,\n  threadId: null,\n};\ndata.appeals[appealId] = appeal;\ndata.userToAppeal[body.userId] = appealId;\n\nreturn [{ json: { ...body, appealId, appeal } }];\n"
      },
