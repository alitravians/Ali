<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/expanded_background"
    android:padding="20dp"
    android:elevation="8dp">

    <!-- Header with close button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="التحكم بالتسجيل"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:layout_centerVertical="true" />

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_close"
            android:layout_alignParentEnd="true"
            android:contentDescription="إغلاق"
            android:padding="4dp" />

    </RelativeLayout>

    <!-- Timer -->
    <TextView
        android:id="@+id/expandedTimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="00:00:00"
        android:textSize="36sp"
        android:textColor="@android:color/white"
        android:fontFamily="monospace"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- Control Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Pause/Resume Button -->
        <LinearLayout
            android:id="@+id/btnPauseResume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/control_btn_background"
            android:padding="12dp"
            android:layout_marginEnd="8dp">

            <ImageView
                android:id="@+id/iconPauseResume"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_pause"
                android:contentDescription="إيقاف مؤقت" />

            <TextView
                android:id="@+id/txtPauseResume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="إيقاف مؤقت"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Stop Button -->
        <LinearLayout
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/stop_btn_background"
            android:padding="12dp"
            android:layout_marginStart="8dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_stop"
                android:contentDescription="إيقاف" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="إيقاف التسجيل"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
