<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ArabiziKeyboard">

        <!-- Setup Wizard / Main Activity -->
        <activity
            android:name=".setup.SetupWizardActivity"
            android:exported="true"
            android:theme="@style/Theme.ArabiziKeyboard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Settings Activity -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@style/Theme.ArabiziKeyboard" />

        <!-- Dictionary Activity -->
        <activity
            android:name=".settings.DictionaryActivity"
            android:exported="false"
            android:label="@string/settings_dictionary"
            android:theme="@style/Theme.ArabiziKeyboard" />

        <!-- IME Service -->
        <service
            android:name=".service.ArabiziInputMethodService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

    </application>

</manifest>
