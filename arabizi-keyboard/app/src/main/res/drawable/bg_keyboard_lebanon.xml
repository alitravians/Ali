<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base white background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <!-- Top red stripe -->
    <item android:bottom="170dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#CCED1C24"
                android:endColor="#33ED1C24"
                android:angle="270" />
        </shape>
    </item>
    <!-- Bottom red stripe -->
    <item android:top="170dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#33ED1C24"
                android:endColor="#CCED1C24"
                android:angle="270" />
        </shape>
    </item>
    <!-- Subtle green cedar accent line in middle -->
    <item
        android:top="120dp"
        android:bottom="120dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A00A651" />
        </shape>
    </item>
</layer-list>
