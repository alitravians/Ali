<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_keyboard"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_key_special"
        android:padding="24dp"
        android:contentDescription="@string/app_name" />

    <TextView
        style="@style/SetupTitle"
        android:text="@string/setup_welcome_title"
        android:layout_marginBottom="16dp" />

    <TextView
        style="@style/SetupDescription"
        android:text="@string/setup_welcome_desc" />

    <View
        android:layout_width="60dp"
        android:layout_height="3dp"
        android:layout_marginTop="24dp"
        android:background="@color/lebanon_green" />

</LinearLayout>
