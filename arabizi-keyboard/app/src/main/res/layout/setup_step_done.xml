<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_keyboard"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_convert_button"
        android:padding="20dp"
        android:contentDescription="@string/app_name" />

    <TextView
        style="@style/SetupTitle"
        android:text="@string/setup_step_done_title"
        android:textColor="@color/accent" />

    <TextView
        style="@style/SetupDescription"
        android:text="@string/setup_step_done_desc" />

    <!-- Test Area -->
    <EditText
        android:id="@+id/et_test"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:hint="جرّب الكتابة هنا..."
        android:padding="16dp"
        android:background="@drawable/bg_card_rounded"
        android:inputType="text"
        android:textSize="16sp"
        android:importantForAutofill="no" />

</LinearLayout>
