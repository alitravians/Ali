<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        style="@style/SetupTitle"
        android:text="@string/setup_step_language_title" />

    <TextView
        style="@style/SetupDescription"
        android:text="@string/setup_step_language_desc"
        android:layout_marginBottom="24dp" />

    <!-- Language Options -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:foreground="?android:attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <CheckBox
                android:id="@+id/cb_arabizi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lang_arabizi_label"
                android:textSize="16sp"
                android:checked="true"
                android:buttonTint="@color/primary"
                android:padding="8dp" />

            <CheckBox
                android:id="@+id/cb_arabic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lang_arabic_label"
                android:textSize="16sp"
                android:checked="true"
                android:buttonTint="@color/primary"
                android:padding="8dp" />

            <CheckBox
                android:id="@+id/cb_english"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lang_english_label"
                android:textSize="16sp"
                android:checked="true"
                android:buttonTint="@color/primary"
                android:padding="8dp" />

            <CheckBox
                android:id="@+id/cb_conversion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lang_conversion_label"
                android:textSize="16sp"
                android:checked="true"
                android:buttonTint="@color/primary"
                android:padding="8dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
