# BOON Community Bot — environment variables
#
# Copy to `.env` for local development, or set as Fly.io secrets for production:
#   fly secrets set DISCORD_BOT_TOKEN=... GUILD_ID=... GITHUB_TOKEN=...

# Required ─────────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=replace-me
GUILD_ID=replace-me            # Your BOON community server ID

# Optional ─────────────────────────────────────────────────────────────────────
GITHUB_REPO=alitravians/Ali    # Where /report files issues
GITHUB_TOKEN=                  # PAT with `public_repo` scope; leave empty to disable /report
GITHUB_WEBHOOK_SECRET=         # Shared secret for the inbound release webhook

# HTTP listener (used by GitHub webhook). Fly.io sets PORT for us automatically.
PORT=8080

LOG_LEVEL=INFO
