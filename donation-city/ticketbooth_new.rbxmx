						<string name="ScriptGuid">{bb86e705-b65d-440e-b44b-3f98a9ec2a67}</string>
						<string name="Source">function onClicked()
&#9;if script.Parent.Parent.DoorStatus.Value == &quot;Open&quot; then
&#9;&#9;script.Parent.Parent.DoorStatus.Value = &quot;Changing&quot;
&#9;&#9;script.Parent.Parent.DO.Transparency = 1
&#9;&#9;script.Parent.Parent.DO.Transparency = 1
&#9;&#9;script.Parent.Parent.DO.CanCollide = false
&#9;&#9;
&#9;&#9;script.Parent.Parent.DOC.Transparency = 0
&#9;&#9;script.Parent.Parent.DOC.Transparency = 0
&#9;&#9;script.Parent.Parent.DOC.CanCollide = true
&#9;&#9;
&#9;&#9;wait(0.25)
&#9;&#9;
&#9;&#9;script.Parent.Parent.DOC.Transparency = 1
&#9;&#9;script.Parent.Parent.DOC.Transparency = 1
&#9;&#9;script.Parent.Parent.DOC.CanCollide = false
&#9;&#9;
&#9;&#9;script.Parent.Parent.DC.Transparency = 0
&#9;&#9;script.Parent.Parent.DC.Transparency = 0
&#9;&#9;script.Parent.Parent.DC.CanCollide = true
&#9;&#9;script.Parent.Parent.DoorStatus.Value = &quot;Closed&quot;
&#9;elseif script.Parent.Parent.DoorStatus.Value == &quot;Closed&quot; then
&#9;&#9;script.Parent.Parent.DoorStatus.Value = &quot;Changing&quot;
&#9;&#9;script.Parent.Parent.DC.Transparency = 1
&#9;&#9;script.Parent.Parent.DC.Transparency = 1
&#9;&#9;script.Parent.Parent.DC.CanCollide = false
&#9;&#9;
&#9;&#9;script.Parent.Parent.DOC.Transparency = 0
&#9;&#9;script.Parent.Parent.DOC.Transparency = 0
&#9;&#9;script.Parent.Parent.DOC.CanCollide = true
&#9;&#9;
&#9;&#9;wait(0.25)
&#9;&#9;
&#9;&#9;script.Parent.Parent.DOC.Transparency = 1
&#9;&#9;script.Parent.Parent.DOC.Transparency = 1
&#9;&#9;script.Parent.Parent.DOC.CanCollide = false
&#9;&#9;
&#9;&#9;script.Parent.Parent.DO.Transparency = 0
&#9;&#9;script.Parent.Parent.DO.Transparency = 0
&#9;&#9;script.Parent.Parent.DO.CanCollide = true
&#9;&#9;script.Parent.Parent.DoorStatus.Value = &quot;Open&quot;
&#9;end
end

 script.Parent.ClickDetector.MouseClick:connect(onClicked)

</string>
