	AutoButtonColor = false,
	BackgroundColor3 = THEME.Gold,
	TextColor3 = Color3.fromRGB(24, 18, 8),
	Font = Enum.Font.GothamBlack,
	TextSize = 15,
	Text = "",
	Size = UDim2.new(1, -20, 0, 30),
	Position = UDim2.new(0, 10, 1, -40),
	Parent = statusPanel,
