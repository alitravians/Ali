	TextColor3 = PINK,
	TextSize = 13,
	TextXAlignment = Enum.TextXAlignment.Right,
	ZIndex = 6,
	Parent = picker,
})
local pickerList = new("ScrollingFrame", {
	Name = "PickerList",
	Position = UDim2.new(0, 6, 0, 32),
	Size = UDim2.new(1, -12, 1, -38),
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	ScrollBarThickness = 4,
	ScrollBarImageColor3 = PINK,
