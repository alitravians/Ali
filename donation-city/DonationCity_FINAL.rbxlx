		<Item class="Script" referent="10">
			<Properties>
				<ProtectedString name="Source"><![CDATA[--[[
	╔══════════════════════════════════════════════════════════════════════╗
	║  RECENT DONORS — SERVER FEED   (OPTIONAL)                              ║
	║                                                                        ║
	║  PLACEMENT:  ServerScriptService                                       ║
	║  TYPE:       Script  (server-side)                                     ║
	║                                                                        ║
	║  Pushes a short "recent donors" string to every client's loading       ║
	║  screen via an attribute on ReplicatedFirst. Attributes replicate to    ║
	║  clients automatically, so the LoadingScreen LocalScript just reads it. ║
	║                                                                        ║
	║  If you don't have a donation system yet, this script still works —     ║
	║  it just shows the demo names below. Hook RecordDonation() into your    ║
	║  real purchase / donation flow whenever you're ready.                   ║
	╚══════════════════════════════════════════════════════════════════════╝
]]

local ReplicatedFirst = game:GetService("ReplicatedFirst")

local MAX_SHOWN = 5
local recent = {}

-- Call this from your donation/purchase logic, e.g.:
--   RecordDonation(player.DisplayName, 100)
local function publish()
	local parts = {}
	for i = #recent, math.max(1, #recent - MAX_SHOWN + 1), -1 do
		table.insert(parts, recent[i])
	end
	ReplicatedFirst:SetAttribute("RecentDonors", table.concat(parts, "   •   "))
end

local function RecordDonation(name: string, amount: number?)
	local label = if amount then string.format("%s (%d R$)", name, amount) else name
	table.insert(recent, label)
	if #recent > 50 then
		table.remove(recent, 1)
	end
	publish()
end

-- Demo seed so the loading screen has something to show out of the box.
-- Remove these once your real donation system feeds RecordDonation().
RecordDonation("Khalid", 250)
RecordDonation("Sara", 100)
RecordDonation("Omar", 500)

-- Expose to other server scripts via _G (simple) — or replace with a
-- proper ModuleScript / BindableEvent in your architecture.
_G.RecordDonation = RecordDonation

return RecordDonation
]]></ProtectedString>
