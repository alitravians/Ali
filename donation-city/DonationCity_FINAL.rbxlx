        <Item class="Script" referent="TB000077">
          <Properties>
            <string name="Name">Main</string>
            <BinaryString name="AttributesSerialize"/>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <bool name="Disabled">false</bool>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <token name="RunContext">0</token>
            <bool name="DefinesCapabilities">false</bool>
            <string name="Source"><![CDATA[function onClicked()
	if script.Parent.Parent.DoorStatus.Value == "Open" then
		script.Parent.Parent.DoorStatus.Value = "Changing"
		script.Parent.Parent.DO.Transparency = 1
		script.Parent.Parent.DO.Transparency = 1
		script.Parent.Parent.DO.CanCollide = false
		
		script.Parent.Parent.DOC.Transparency = 0
		script.Parent.Parent.DOC.Transparency = 0
		script.Parent.Parent.DOC.CanCollide = true
		
		wait(0.25)
		
		script.Parent.Parent.DOC.Transparency = 1
		script.Parent.Parent.DOC.Transparency = 1
		script.Parent.Parent.DOC.CanCollide = false
		
		script.Parent.Parent.DC.Transparency = 0
		script.Parent.Parent.DC.Transparency = 0
		script.Parent.Parent.DC.CanCollide = true
		script.Parent.Parent.DoorStatus.Value = "Closed"
	elseif script.Parent.Parent.DoorStatus.Value == "Closed" then
		script.Parent.Parent.DoorStatus.Value = "Changing"
		script.Parent.Parent.DC.Transparency = 1
		script.Parent.Parent.DC.Transparency = 1
		script.Parent.Parent.DC.CanCollide = false
		
		script.Parent.Parent.DOC.Transparency = 0
		script.Parent.Parent.DOC.Transparency = 0
		script.Parent.Parent.DOC.CanCollide = true
		
		wait(0.25)
		
		script.Parent.Parent.DOC.Transparency = 1
		script.Parent.Parent.DOC.Transparency = 1
		script.Parent.Parent.DOC.CanCollide = false
		
		script.Parent.Parent.DO.Transparency = 0
		script.Parent.Parent.DO.Transparency = 0
		script.Parent.Parent.DO.CanCollide = true
		script.Parent.Parent.DoorStatus.Value = "Open"
	end
end

 script.Parent.ClickDetector.MouseClick:connect(onClicked)

]]></string>
