	AnchorPoint = Vector2.new(0, 1),
	Position = UDim2.new(0, 8, 1, -52),
	Size = UDim2.new(1, -16, 0, 150),
	BackgroundColor3 = Color3.fromRGB(14, 10, 26),
	BackgroundTransparency = 0.02,
	BorderSizePixel = 0,
	Visible = false,
	ZIndex = 8,
