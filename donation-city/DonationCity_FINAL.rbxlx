-- حلقة التقدّم حول البصمة
local progRing = Instance.new("Frame")
progRing.AnchorPoint = Vector2.new(0.5, 0.5)
progRing.Size = UDim2.new(0, 250, 0, 250)
progRing.Position = UDim2.new(0.5, 0, 0.5, 0)
