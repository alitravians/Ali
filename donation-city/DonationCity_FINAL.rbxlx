	-- صورتان للسلايد-شو (Decals) لعمل تلاشٍ ناعم بينهما — بين الشريطين السينمائيين
	for i = 1, 2 do
		local img = Instance.new("ImageLabel")
		img.Name = "Slide" .. i
		img.Size = UDim2.new(1, 0, 0.8, 0)
