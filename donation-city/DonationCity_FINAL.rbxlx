local LOCKCOL = Color3.fromRGB(255, 184, 92)
local OFFCOL  = Color3.fromRGB(232, 96, 110)

local cmdList: { any } = {}    -- آخر إعدادات وصلت من السيرفر
local myWeight = 0             -- وزن رتبتي (لتحديد المتاح)

-- طبقة معتمة خلف اللوحة
