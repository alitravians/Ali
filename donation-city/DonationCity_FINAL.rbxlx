_G.EventIncomeMult = 1

-- تعريف الإنجازات (Modular)
local ACH = {
	first_ticket = { emoji = "🎟️", name = "أول تذكرة",  desc = "اشتريت أول تذكرة" },
	first_movie  = { emoji = "🎬", name = "أول فيلم",   desc = "حضرت أول عرض سينمائي" },
	vip          = { emoji = "⭐", name = "عضو VIP",    desc = "أصبحت عضو VIP" },
