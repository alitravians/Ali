generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== Users ====================
model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  password      String
  displayName   String?
  avatar        String?
  bio           String?
  level         Int       @default(1)
  xp            Int       @default(0)
  status        UserStatus @default(OFFLINE)
  lastActive    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  userRoles       UserRole[]
  roomMemberships RoomMember[]
  roomModerators  RoomModerator[]
  messages        Message[]
  messageEdits    MessageEdit[]
  sentReports     Report[]       @relation("ReportSender")
  receivedReports Report[]       @relation("ReportTarget")
  warnings        Warning[]      @relation("WarningTarget")
  issuedWarnings  Warning[]      @relation("WarningIssuer")
  mutes           Mute[]         @relation("MuteTarget")
  issuedMutes     Mute[]         @relation("MuteIssuer")
  bans            Ban[]          @relation("BanTarget")
  issuedBans      Ban[]          @relation("BanIssuer")
  adminNotes      AdminNote[]    @relation("AdminNoteTarget")
  createdAdminNotes AdminNote[]  @relation("AdminNoteCreator")
  modNotes        ModeratorNote[] @relation("ModNoteTarget")
  createdModNotes ModeratorNote[] @relation("ModNoteCreator")
  announcements   Announcement[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  createdRooms    Room[]         @relation("RoomCreator")
  teamMemberships TeamMember[]
  reactions       Reaction[]
  blockedUsers    UserBlock[]    @relation("BlockedByUser")
  blockedBy       UserBlock[]    @relation("BlockedUser")
  tickets         Ticket[]       @relation("TicketCreator")
  assignedTickets Ticket[]       @relation("TicketAssignee")
  ticketReplies   TicketReply[]
  githubFixes     GitHubFix[]

  @@map("users")
}

enum UserStatus {
  ONLINE
  OFFLINE
  AWAY
  DO_NOT_DISTURB
}

// ==================== Roles & Permissions ====================
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  level       Int      @default(0)
  color       String   @default("#808080")
  icon        String?
  isDefault   Boolean  @default(false)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  category    String   @default("general")
  createdAt   DateTime @default(now())

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ==================== Rooms ====================
model Room {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  type        RoomType @default(PUBLIC)
  isPrivate   Boolean  @default(false)
  isFrozen    Boolean  @default(false)
  maxMembers  Int?
  sortOrder   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  createdBy    User?          @relation("RoomCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members      RoomMember[]
  moderators   RoomModerator[]
  messages     Message[]
  reports      Report[]

  @@map("rooms")
}

enum RoomType {
  PUBLIC
  PRIVATE
  ANNOUNCEMENT
}

model RoomMember {
  id       String   @id @default(cuid())
  userId   String
  roomId   String
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@map("room_members")
}

model RoomModerator {
  id         String   @id @default(cuid())
  userId     String
  roomId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@map("room_moderators")
}

// ==================== Messages ====================
model Message {
  id        String   @id @default(cuid())
  content   String
  userId    String
  roomId    String
  replyToId String?
  isEdited  Boolean  @default(false)
  isDeleted Boolean  @default(false)
  isBold    Boolean  @default(false)
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  room     Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  replyTo  Message?      @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies  Message[]     @relation("MessageReply")
  edits    MessageEdit[]
  reports  Report[]
  reactions Reaction[]

  @@index([roomId, createdAt])
  @@map("messages")
}

model MessageEdit {
  id         String   @id @default(cuid())
  messageId  String
  editedById String
  oldContent String
  newContent String
  editedAt   DateTime @default(now())

  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  editedBy User    @relation(fields: [editedById], references: [id], onDelete: Cascade)

  @@map("message_edits")
}

// ==================== Reports ====================
model Report {
  id           String       @id @default(cuid())
  reporterId   String
  targetUserId String?
  messageId    String?
  roomId       String?
  reason       String
  details      String?
  status       ReportStatus @default(PENDING)
  resolvedById String?
  resolvedAt   DateTime?
  resolution   String?
  createdAt    DateTime     @default(now())

  reporter   User     @relation("ReportSender", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser User?    @relation("ReportTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  message    Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  room       Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@map("reports")
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
  ESCALATED
}

// ==================== Warnings ====================
model Warning {
  id        String   @id @default(cuid())
  userId    String
  issuedBy  String
  reason    String
  roomId    String?
  createdAt DateTime @default(now())

  user   User @relation("WarningTarget", fields: [userId], references: [id], onDelete: Cascade)
  issuer User @relation("WarningIssuer", fields: [issuedBy], references: [id], onDelete: Cascade)

  @@map("warnings")
}

// ==================== Mutes ====================
model Mute {
  id        String   @id @default(cuid())
  userId    String
  issuedBy  String
  reason    String
  roomId    String?
  duration  Int      // in minutes
  startsAt  DateTime @default(now())
  expiresAt DateTime
  isActive  Boolean  @default(true)
  liftedBy  String?
  liftedAt  DateTime?
  createdAt DateTime @default(now())

  user   User @relation("MuteTarget", fields: [userId], references: [id], onDelete: Cascade)
  issuer User @relation("MuteIssuer", fields: [issuedBy], references: [id], onDelete: Cascade)

  @@map("mutes")
}

// ==================== Bans ====================
model Ban {
  id        String   @id @default(cuid())
  userId    String
  issuedBy  String
  reason    String
  duration  Int?     // in minutes, null = permanent
  startsAt  DateTime @default(now())
  expiresAt DateTime?
  isActive  Boolean  @default(true)
  isGlobal  Boolean  @default(true)
  liftedBy  String?
  liftedAt  DateTime?
  createdAt DateTime @default(now())

  user   User @relation("BanTarget", fields: [userId], references: [id], onDelete: Cascade)
  issuer User @relation("BanIssuer", fields: [issuedBy], references: [id], onDelete: Cascade)

  @@map("bans")
}

// ==================== Announcements ====================
model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdBy String
  isPinned  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("announcements")
}

// ==================== Notifications ====================
model Notification {
  id        String               @id @default(cuid())
  userId    String
  type      NotificationType
  category  NotificationCategory @default(GENERAL)
  priority  NotificationPriority @default(NORMAL)
  title     String
  content   String?
  isRead    Boolean              @default(false)
  isArchived Boolean             @default(false)
  link      String?
  metadata  Json?
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, category])
  @@map("notifications")
}

enum NotificationType {
  WARNING
  MUTE
  BAN
  UNMUTE
  UNBAN
  ANNOUNCEMENT
  REPORT_STATUS
  SYSTEM
  MENTION
  REACTION
  TICKET
  BADGE
  LEVEL_UP
  XP
  PROFILE
  ADMIN
  ITEM
}

enum NotificationCategory {
  ADMIN
  TICKET
  CHAT
  PUNISHMENT
  ITEM
  BADGE
  LEVEL
  PROFILE
  GENERAL
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ==================== Admin Notes ====================
model AdminNote {
  id           String   @id @default(cuid())
  content      String
  createdBy    String
  targetUserId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author     User  @relation("AdminNoteCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  targetUser User? @relation("AdminNoteTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@map("admin_notes")
}

// ==================== Moderator Notes ====================
model ModeratorNote {
  id           String   @id @default(cuid())
  content      String
  createdBy    String
  targetUserId String?
  createdAt    DateTime @default(now())

  author     User  @relation("ModNoteCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  targetUser User? @relation("ModNoteTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@map("moderator_notes")
}

// ==================== Audit Logs ====================
model AuditLog {
  id           String   @id @default(cuid())
  action       String
  performedBy  String
  targetUserId String?
  details      Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  performer User @relation(fields: [performedBy], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("audit_logs")
}

// ==================== Site Settings ====================
model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ==================== Banned Words ====================
model BannedWord {
  id        String   @id @default(cuid())
  word      String   @unique
  createdBy String?
  createdAt DateTime @default(now())

  @@map("banned_words")
}

// ==================== Team System ====================
model TeamDepartment {
  id        String   @id @default(cuid())
  name      String   @default("")
  nameAr    String
  color     String   @default("#2563eb")
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())

  members   TeamMember[]

  @@map("team_departments")
}

model TeamMember {
  id           String   @id @default(cuid())
  userId       String
  departmentId String
  role         String   @default("")
  roleAr       String   @default("")
  order        Int      @default(0)
  isVisible    Boolean  @default(true)
  createdAt    DateTime @default(now())

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   TeamDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@map("team_members")
}

// ==================== Reactions ====================
model Reaction {
  id        String   @id @default(cuid())
  emoji     String
  userId    String
  messageId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId, emoji])
  @@index([messageId])
  @@map("reactions")
}

// ==================== Support Tickets ====================
model Ticket {
  id          String         @id @default(cuid())
  title       String
  department  String         // e.g. "technical", "account", "chat", etc.
  type        String         // e.g. "bug", "help", "report", "inquiry", "suggestion"
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)
  description String
  userId      String
  assignedTo  String?
  closedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user     User           @relation("TicketCreator", fields: [userId], references: [id], onDelete: Cascade)
  assignee User?          @relation("TicketAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  replies  TicketReply[]

  @@index([userId])
  @@index([status])
  @@map("tickets")
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  content   String
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ticket_replies")
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  REVIEWING
  REPLIED
  WAITING_USER
  CLOSED
  ESCALATED
  ARCHIVED
}

// ==================== User Blocks ====================
model UserBlock {
  id            String   @id @default(cuid())
  blockedById   String
  blockedUserId String
  createdAt     DateTime @default(now())

  blockedBy   User @relation("BlockedByUser", fields: [blockedById], references: [id], onDelete: Cascade)
  blockedUser User @relation("BlockedUser", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockedById, blockedUserId])
  @@map("user_blocks")
}

// ==================== GitHub Monitor ====================
model GitHubAppConfig {
  id              String   @id @default(cuid())
  appId           String
  privateKey      String   // Encrypted server-side
  installationId  String
  webhookSecret   String
  repoOwner       String
  repoName        String
  defaultBranch   String   @default("main")
  isActive        Boolean  @default(true)
  lastSyncAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("github_app_config")
}

model GitHubEvent {
  id          String              @id @default(cuid())
  eventType   GitHubEventType
  title       String
  description String?
  actor       String?
  branch      String?
  commitSha   String?
  metadata    Json?
  severity    GitHubSeverity      @default(INFO)
  isRead      Boolean             @default(false)
  createdAt   DateTime            @default(now())

  fileChanges GitHubFileChange[]

  @@index([eventType])
  @@index([createdAt])
  @@map("github_events")
}

enum GitHubEventType {
  PUSH
  PULL_REQUEST
  CHECK_RUN
  CHECK_SUITE
  CODE_SCAN_ALERT
  SECRET_SCAN_ALERT
  DEPENDABOT_ALERT
  WORKFLOW_RUN
  MANUAL_SYNC
}

enum GitHubSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

model GitHubFileChange {
  id          String               @id @default(cuid())
  eventId     String
  filePath    String
  changeType  GitHubFileChangeType
  oldPath     String?
  additions   Int                  @default(0)
  deletions   Int                  @default(0)
  commitSha   String?
  author      String?
  createdAt   DateTime             @default(now())

  event GitHubEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("github_file_changes")
}

enum GitHubFileChangeType {
  ADDED
  MODIFIED
  DELETED
  RENAMED
}

model GitHubAlert {
  id                String            @id @default(cuid())
  alertType         GitHubAlertType
  title             String
  description       String?
  severity          GitHubSeverity    @default(WARNING)
  filePath          String?
  lineNumber        Int?
  state             GitHubAlertState  @default(OPEN)
  githubAlertNumber Int?
  ruleId            String?
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([alertType])
  @@index([state])
  @@map("github_alerts")
}

enum GitHubAlertType {
  CODE_SCAN
  SECRET_SCAN
  DEPENDABOT
}

enum GitHubAlertState {
  OPEN
  FIXED
  DISMISSED
}

model GitHubCheck {
  id          String             @id @default(cuid())
  name        String
  status      GitHubCheckStatus
  conclusion  GitHubCheckConclusion?
  branch      String?
  commitSha   String?
  startedAt   DateTime?
  completedAt DateTime?
  detailsUrl  String?
  output      Json?
  createdAt   DateTime           @default(now())

  @@index([commitSha])
  @@map("github_checks")
}

enum GitHubCheckStatus {
  QUEUED
  IN_PROGRESS
  COMPLETED
}

enum GitHubCheckConclusion {
  SUCCESS
  FAILURE
  NEUTRAL
  CANCELLED
  TIMED_OUT
  ACTION_REQUIRED
  SKIPPED
  STALE
}

model GitHubFix {
  id            String          @id @default(cuid())
  filePath      String
  oldContent    String?
  newContent    String
  commitMessage String
  fixType       GitHubFixType
  branch        String?
  prNumber      Int?
  prUrl         String?
  performedBy   String
  status        GitHubFixStatus @default(PENDING)
  createdAt     DateTime        @default(now())

  performer User @relation(fields: [performedBy], references: [id], onDelete: Cascade)

  @@index([performedBy])
  @@map("github_fixes")
}

enum GitHubFixType {
  DIRECT
  PR
}

enum GitHubFixStatus {
  PENDING
  COMMITTED
  MERGED
  FAILED
}
