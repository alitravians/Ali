generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          String    @default("user") // user | admin
  points        Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  progress      UserProgress[]
  testResults   TestResult[]
  certificates  Certificate[]
  badges        UserBadge[]
  notifications Notification[]
  tickets       Ticket[]
  notificationSettings NotificationSettings?
}

model Language {
  id          String   @id @default(cuid())
  name        String
  nameAr      String
  code        String   @unique
  flag        String   @default("")
  description String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  levels      Level[]
}

model Level {
  id           String   @id @default(cuid())
  name         String
  nameAr       String
  order        Int
  description  String   @default("")
  passingScore Int      @default(70)
  languageId   String
  createdAt    DateTime @default(now())

  language     Language  @relation(fields: [languageId], references: [id], onDelete: Cascade)
  lessons      Lesson[]
  tests        Test[]
  progress     UserProgress[]
  certificates Certificate[]
}

model Lesson {
  id          String   @id @default(cuid())
  title       String
  titleAr     String
  order       Int
  content     String   @default("")
  levelId     String
  createdAt   DateTime @default(now())

  level       Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  words       Word[]
  grammarRules GrammarRule[]
  questions   Question[]
}

model Word {
  id            String   @id @default(cuid())
  word          String
  translation   String
  translationAr String   @default("")
  pronunciation String   @default("")
  example       String   @default("")
  exampleTranslation String @default("")
  audioUrl      String   @default("")
  lessonId      String
  createdAt     DateTime @default(now())

  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model GrammarRule {
  id          String   @id @default(cuid())
  title       String
  titleAr     String   @default("")
  explanation String
  explanationAr String @default("")
  examples    String   @default("[]")
  lessonId    String
  createdAt   DateTime @default(now())

  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Question {
  id          String   @id @default(cuid())
  type        String   // multiple_choice | matching | writing | listening | pronunciation
  question    String
  questionAr  String   @default("")
  options     String   @default("[]")
  answer      String
  explanation String   @default("")
  audioUrl    String   @default("")
  points      Int      @default(10)
  lessonId    String
  createdAt   DateTime @default(now())

  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Test {
  id          String   @id @default(cuid())
  title       String
  titleAr     String   @default("")
  type        String   @default("level") // lesson | level | final
  passingScore Int     @default(70)
  levelId     String
  createdAt   DateTime @default(now())

  level       Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  results     TestResult[]
}

model TestResult {
  id          String   @id @default(cuid())
  score       Int
  totalPoints Int
  passed      Boolean
  answers     String   @default("[]")
  userId      String
  testId      String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  test        Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model UserProgress {
  id              String   @id @default(cuid())
  userId          String
  levelId         String
  completedLessons String  @default("[]")
  readingScore    Int      @default(0)
  writingScore    Int      @default(0)
  listeningScore  Int      @default(0)
  speakingScore   Int      @default(0)
  overallProgress Int      @default(0)
  isCompleted     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level           Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
}

model Certificate {
  id              String   @id @default(cuid())
  certificateCode String   @unique
  userName        String
  languageName    String
  levelName       String
  score           Int      @default(0)
  grade           String   @default("good")
  gradeAr         String   @default("جيد")
  readingScore    Int      @default(0)
  writingScore    Int      @default(0)
  listeningScore  Int      @default(0)
  speakingScore   Int      @default(0)
  issueDate       DateTime @default(now())
  expiresAt       DateTime?
  userId          String
  levelId         String

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level           Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
}

model UserBadge {
  id          String   @id @default(cuid())
  name        String
  nameAr      String   @default("")
  description String   @default("")
  icon        String   @default("")
  userId      String
  earnedAt    DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  titleAr   String   @default("")
  message   String
  messageAr String   @default("")
  type      String   @default("info") // info | success | warning | achievement
  category  String   @default("general") // educational | certificates | support | account | admin | general
  icon      String   @default("bell") // bell | book | award | ticket | user | megaphone | star | check | alert
  link      String   @default("") // internal link e.g. /profile/tickets/123
  priority  String   @default("normal") // normal | important | urgent
  isRead    Boolean  @default(false)
  isDeleted Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationSettings {
  id                    String  @id @default(cuid())
  userId                String  @unique
  inAppEnabled          Boolean @default(true)
  emailEnabled          Boolean @default(false)
  educationalEnabled    Boolean @default(true)
  certificatesEnabled   Boolean @default(true)
  supportEnabled        Boolean @default(true)
  accountEnabled        Boolean @default(true)
  adminEnabled          Boolean @default(true)

  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminNotification {
  id          String   @id @default(cuid())
  title       String
  titleAr     String   @default("")
  message     String
  messageAr   String   @default("")
  category    String   @default("admin")
  link        String   @default("")
  priority    String   @default("normal")
  targetType  String   @default("all") // all | specific
  targetUsers String   @default("") // comma-separated user IDs if specific
  sentCount   Int      @default(0)
  readCount   Int      @default(0)
  sentAt      DateTime @default(now())
  sentBy      String   @default("admin")
}

model SiteSettings {
  id                 String  @id @default("settings")
  siteName           String  @default("LinguaMaster")
  siteDescription    String  @default("منصة تعلم اللغات الأجنبية")
  maintenanceMode    Boolean @default(false)
  maintenanceMessage String  @default("الموقع تحت الصيانة حالياً")
  stampTopText       String  @default("LINGUAMASTER")
  stampBottomText    String  @default("CERTIFIED")
  stampCenterText    String  @default("معتمدة")
  stampVerifyBottomText String @default("VERIFIED")
  stampVerifyCenterText String @default("موثقة")
  stampColor         String  @default("#1e40af")
  stampStars         Int     @default(3)
  stampShowDots      Boolean @default(true)
}

model Ticket {
  id          String   @id @default(cuid())
  ticketCode  String   @unique
  subject     String
  description String
  category    String   @default("general") // technical | general | account | tests | certificates
  priority    String   @default("medium")  // low | medium | high
  status      String   @default("open")    // open | in_review | replied | closed
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    TicketMessage[]
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model TicketMessage {
  id        String   @id @default(cuid())
  content   String
  isAdmin   Boolean  @default(false)
  senderName String  @default("")
  ticketId  String
  createdAt DateTime @default(now())

  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model SystemScan {
  id              String   @id @default(cuid())
  status          String   @default("running") // running | completed | failed
  scanType        String   @default("full") // full | pages | files | api | database | performance | security | tickets | notifications | certificates | tests
  totalChecks     Int      @default(0)
  passedChecks    Int      @default(0)
  failedChecks    Int      @default(0)
  criticalCount   Int      @default(0)
  highCount       Int      @default(0)
  mediumCount     Int      @default(0)
  lowCount        Int      @default(0)
  duration        Int      @default(0) // milliseconds
  summary         String   @default("")
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  startedBy       String   @default("admin")

  issues          SystemIssue[]
}

model SystemIssue {
  id              String   @id @default(cuid())
  name            String
  type            String   // page | file | api | database | performance | security | config | ui
  severity        String   // critical | high | medium | low
  section         String   @default("") // affected page or section
  fileName        String   @default("")
  filePath        String   @default("")
  lineNumber      Int?
  description     String
  cause           String   @default("")
  solution        String   @default("")
  recommendation  String   @default("")
  status          String   @default("new") // new | in_progress | fixed | ignored
  scanId          String
  detectedAt      DateTime @default(now())

  scan            SystemScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
}
