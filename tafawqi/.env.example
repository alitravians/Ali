# PostgreSQL connection string (e.g. from Vercel Postgres, Neon, Supabase)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT signing secret — generate a strong random string for production
AUTH_SECRET="please-change-me-in-production"

# Token guarding the one-time /api/admin/seed endpoint
SEED_TOKEN="tafawqi-seed-token"
