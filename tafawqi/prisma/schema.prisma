// Tafawqi — Arabic math testing platform for 10th-grade Syrian female students
// Prisma schema (SQLite for dev; can swap to PostgreSQL/Turso for production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────── المستخدِمات والمشرفون ───────────
model User {
  id                 String          @id @default(cuid())
  email              String          @unique
  name               String
  passwordHash       String
  phone              String?
  role               String          @default("student") // student | admin
  points             Int             @default(0)
  avatarSeed         String          @default("default")
  // Optional base64-encoded uploaded avatar (data:image/webp;base64,...). When
  // empty, the UI falls back to the DiceBear seed avatar generated from
  // avatarSeed. Stored as TEXT in Postgres — no size limit.
  avatar             String          @default("")
  isBlocked          Boolean         @default(false)
  // Bumped on password change so older JWTs are auto-invalidated.
  passwordChangedAt  DateTime?
  // Sustained-failure lockout (separate from per-IP/per-email rate limit).
  failedLoginCount   Int             @default(0)
  lockedUntil        DateTime?
  // S2 — set when the user clicks the verification link in their inbox.
  // Null while the email is unverified. Gating the rest of the app on this
  // is controlled by the SiteSetting key "email_verification_required".
  emailVerifiedAt    DateTime?
  // F18 / S4 — optional admin 2FA. Both fields are null until an admin opts in.
  totpSecret         String?
  totpEnabledAt      DateTime?
  // F2 — streak system. streakDays = consecutive days with at least one
  // finished attempt. streakBestDays = personal record. streakLastDate =
  // the UTC date (00:00) of the most recent attempt that advanced the streak.
  streakDays         Int             @default(0)
  streakBestDays     Int             @default(0)
  streakLastDate     DateTime?
  // F2 — daily-quiz redemption. Stores the UTC date the user last claimed
  // the daily-quiz bonus so we only award it once per day per user.
  dailyQuizClaimedAt DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  attempts           Attempt[]
  badges             UserBadge[]
  certificates       Certificate[]
  notifications      Notification[]
  resetTokens        PasswordReset[]
  emailVerifications EmailVerification[]
  adminAuditLogs     AdminAuditLog[]
  teamMemberships    TeamMember[]
  // F6 — question reports submitted by this user, and reports resolved by
  // this admin. Two named relations because both point at User.
  questionReports    QuestionReport[] @relation("UserQuestionReports")
  resolvedReports    QuestionReport[] @relation("AdminResolvedReports")
  // F17 — parent share links generated by this student
  parentLinks        ParentLink[]
  // F20 — contact messages resolved by this admin
  contactsResolved   ContactMessage[] @relation("AdminContactsResolved")

  @@index([role, points(sort: Desc)])
}

// ─────────── سجلّ الأحداث الإداريّة ───────────
model AdminAuditLog {
  id          String   @id @default(cuid())
  adminId     String
  admin       User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action      String   // block_user, unblock_user, change_role, reset_points, delete_question, etc.
  targetType  String   // user | question | quiz | setting | other
  targetId    String?
  details     String?  // optional JSON-encoded extra context
  ip          String?
  createdAt   DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([adminId, createdAt(sort: Desc)])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

// S2 — Email verification tokens. Sent when a user registers (when SMTP is
// configured) or when they request a re-send. Independent of PasswordReset
// so we can have both active in parallel without collisions.
model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String   // snapshot so even if user changes email we know which to verify
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

// ─────────── المنهج ───────────
model Chapter {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String
  order       Int       @default(0)
  icon        String    @default("📘")
  color       String    @default("#7c3aed")
  sections    Section[]
  quizzes     Quiz[]
}

model Section {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  description String
  order       Int        @default(0)
  chapterId   String
  chapter     Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  questions   Question[]
  quizzes     Quiz[]
}

// ─────────── الأسئلة والاختبارات ───────────
model Question {
  id          String   @id @default(cuid())
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  type        String   // mcq | tf | fill | match | order
  prompt      String
  // JSON encoded payload (options, answer, etc.)
  payload     String
  explanation String   @default("")
  difficulty  Int      @default(1) // 1 easy, 2 medium, 3 hard
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  quizItems   QuizQuestion[]
  answers     AttemptAnswer[]
  reports     QuestionReport[]
}

// F6 — player-reported issues on a specific question (typo, wrong answer,
// confusing wording, etc.). Admin reviews from the admin panel and either
// resolves (with a note) or dismisses. Soft-state — we never delete reports
// even when resolved so we can spot repeat problems.
model QuestionReport {
  id          String   @id @default(cuid())
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  // Optional: nullable so we can preserve reports even if the reporter is
  // later deleted. setNull keeps the row but blanks the FK.
  userId       String?
  user         User?   @relation("UserQuestionReports", fields: [userId], references: [id], onDelete: SetNull)
  reason       String  // typo | wrong_answer | confusing | other
  comment      String  @default("")
  status       String  @default("pending") // pending | resolved | dismissed
  resolvedById String?
  resolvedBy   User?   @relation("AdminResolvedReports", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  adminNote    String  @default("")
  createdAt    DateTime @default(now())

  @@index([status, createdAt(sort: Desc)])
  @@index([questionId])
}

model Quiz {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  description String         @default("")
  chapterId   String?
  chapter     Chapter?       @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  sectionId   String?
  section     Section?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  kind        String         @default("short") // short | medium | endOfUnit | review | daily
  durationSec Int            @default(120)
  questionCount Int          @default(5)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  items       QuizQuestion[]
  attempts    Attempt[]
}

model QuizQuestion {
  id         String   @id @default(cuid())
  quizId     String
  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int      @default(0)

  @@unique([quizId, questionId])
}

// ─────────── المحاولات والإجابات ───────────
model Attempt {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId     String
  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score      Int      @default(0)
  total      Int      @default(0)
  durationSec Int     @default(0)
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  answers    AttemptAnswer[]

  @@index([userId, finishedAt(sort: Desc)])
  @@index([quizId, finishedAt(sort: Desc)])
}

model AttemptAnswer {
  id         String   @id @default(cuid())
  attemptId  String
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     String   // JSON encoded
  isCorrect  Boolean  @default(false)
  timeMs     Int      @default(0)

  @@index([attemptId])
  @@index([questionId, isCorrect])
}

// ─────────── الشارات والتحفيز ───────────
model Badge {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  description String
  icon        String      @default("🏅")
  color       String      @default("#f59e0b")
  threshold   Int         @default(0) // points needed
  kind        String      @default("points") // points | streak | section
  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

model Certificate {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  kind       String   @default("chapter") // chapter | section | overall
  refId      String   // chapter/section id
  issuedAt   DateTime @default(now())
  code       String   @unique
}

// ─────────── الإشعارات ───────────
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  kind      String   @default("info") // info | success | warning | suggestion
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt(sort: Desc)])
}

// ─────────── إعدادات الموقع ───────────
model SiteSetting {
  key   String @id
  value String
}

// ─────────── فريق العمل (الأقسام والأعضاء) ───────────
// Departments are user-defined groups (e.g. "الإدارة", "المشرفات", "دعم الطالبات").
// Members link an existing User to a department with an optional Arabic job
// title. Both the department and the membership can be hidden without
// deleting so the admin can build the page incrementally.
model TeamDepartment {
  id        String       @id @default(cuid())
  nameAr    String
  color     String       @default("#2563eb") // header accent color (hex)
  order     Int          @default(0)
  isVisible Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  members   TeamMember[]

  @@index([isVisible, order])
}

model TeamMember {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   TeamDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  roleAr       String         @default("") // المسمى الوظيفي بالعربية
  order        Int            @default(0)
  isVisible    Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([userId, departmentId])
  @@index([departmentId, isVisible, order])
}

// F17 — Parent share links.
// A read-only public link a student can give to a parent to view her
// progress without sharing her password. The link is just an unguessable
// token; revoking it (revokedAt set) makes /parent/<token> return 404.
model ParentLink {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String    @unique
  label        String    @default("") // الاسم الوديّ للرابط (اختياري، يكتبه الطالبة)
  lastViewedAt DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, revokedAt])
}

// F20 — Contact messages from /contact.
// Any visitor can POST; rate-limited per IP. Admin reviews + marks resolved.
model ContactMessage {
  id           String    @id @default(cuid())
  name         String
  email        String
  subject      String
  message      String
  ip           String?
  userAgent    String?
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("AdminContactsResolved", fields: [resolvedById], references: [id])
  createdAt    DateTime  @default(now())

  @@index([resolvedAt, createdAt(sort: Desc)])
}
